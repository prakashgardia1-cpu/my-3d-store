  <!-- Client-Side Scripts (3D Viewer, Cost Engine, Filter, Checkout) -->
  <script>
    // ----------------------------------------------------
    // 1. THREE.JS 3D MODEL VIEWER SIMULATION
    // ----------------------------------------------------
    let scene, camera, renderer, controls, currentMeshGroup;
    let isWireframe = false;
    let autoRotate = true;
    let currentColor = 0x111827; // Default matte black

    function init3DViewer() {
      const container = document.getElementById('threeCanvas');
      if (!container || !window.THREE) return;

      const width = container.clientWidth;
      const height = container.clientHeight;

      scene = new window.THREE.Scene();
      camera = new window.THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
      camera.position.set(0, 5, 12);

      renderer = new window.THREE.WebGLRenderer({ canvas: container, antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

      if (window.THREE.OrbitControls) {
        controls = new window.THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        controls.autoRotate = autoRotate;
        controls.autoRotateSpeed = 2.0;
      }

      // Lights
      const ambientLight = new window.THREE.AmbientLight(0xffffff, 0.7);
      scene.add(ambientLight);

      const dirLight1 = new window.THREE.DirectionalLight(0x38bdf8, 1.2);
      dirLight1.position.set(5, 10, 7);
      scene.add(dirLight1);

      const dirLight2 = new window.THREE.DirectionalLight(0x10b981, 0.8);
      dirLight2.position.set(-5, -5, -5);
      scene.add(dirLight2);

      // Load Initial Procedural Iris Model
      loadModelPreset('iris');

      // Animation Loop
      function animate() {
        requestAnimationFrame(animate);
        if (controls) controls.update();
        renderer.render(scene, camera);
      }
      animate();

      // Window Resize Listener
      window.addEventListener('resize', () => {
        if (!container || !renderer || !camera) return;
        const w = container.clientWidth;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });
    }

    // Procedural 3D Generators for Models
    function loadModelPreset(type) {
      if (!scene || !window.THREE) return;
      if (currentMeshGroup) scene.remove(currentMeshGroup);
      currentMeshGroup = new window.THREE.Group();

      const mat = new window.THREE.MeshStandardMaterial({
        color: currentColor,
        roughness: 0.35,
        metalness: 0.2,
        wireframe: isWireframe
      });

      const infoText = document.getElementById('viewerInfoText');

      if (type === 'iris') {
        // Iris Outer Ring
        const ringGeo = new window.THREE.CylinderGeometry(4, 4, 1.2, 32, 1, true);
        const ringMesh = new window.THREE.Mesh(ringGeo, mat);
        currentMeshGroup.add(ringMesh);

        // 8 Internal Iris Blades
        for (let i = 0; i < 8; i++) {
          const bladeGeo = new window.THREE.BoxGeometry(2.4, 0.1, 1.6);
          const bladeMesh = new window.THREE.Mesh(bladeGeo, mat);
          const angle = (i / 8) * Math.PI * 2;
          bladeMesh.position.set(Math.cos(angle) * 1.8, 0, Math.sin(angle) * 1.8);
          bladeMesh.rotation.y = -angle + 0.5;
          currentMeshGroup.add(bladeMesh);
        }
        if (infoText) infoText.innerText = "मैकेनिकल आइरिस (8-ब्लेड असेंबली • 0.16mm लेयर)";
      } else if (type === 'bearing') {
        // Bearing Rings & Steel Balls
        const outerGeo = new window.THREE.TorusGeometry(3.5, 0.6, 16, 50);
        const outer = new window.THREE.Mesh(outerGeo, mat);
        outer.rotation.x = Math.PI / 2;
        currentMeshGroup.add(outer);

        // 8 Chrome Steel Balls
        const ballMat = new window.THREE.MeshStandardMaterial({ color: 0xe2e8f0, roughness: 0.1, metalness: 0.95 });
        for (let i = 0; i < 8; i++) {
          const ballGeo = new window.THREE.SphereGeometry(0.5, 16, 16);
          const ball = new window.THREE.Mesh(ballGeo, isWireframe ? mat : ballMat);
          const angle = (i / 8) * Math.PI * 2;
          ball.position.set(Math.cos(angle) * 3.5, 0, Math.sin(angle) * 3.5);
          currentMeshGroup.add(ball);
        }
        if (infoText) infoText.innerText = "थ्रस्ट बॉल बेयरिंग (स्टील बॉल्स रेसवे असेंबली)";
      } else if (type === 'cross') {
        // Cross Silhouette
        const vBar = new window.THREE.BoxGeometry(0.8, 6.0, 0.4);
        const hBar = new window.THREE.BoxGeometry(3.6, 0.8, 0.4);
        hBar.position.y = 1.0;
        const vMesh = new window.THREE.Mesh(vBar, mat);
        const hMesh = new window.THREE.Mesh(hBar, mat);
        currentMeshGroup.add(vMesh);
        currentMeshGroup.add(hMesh);
        if (infoText) infoText.innerText = "जीसस क्रॉस 3D पेंडेंट (एम्बॉस्ड लेटरिंग)";
      }

      scene.add(currentMeshGroup);
    }

    // Model Switcher Buttons
    document.getElementById('btnModelIris')?.addEventListener('click', (e) => {
      loadModelPreset('iris');
      highlightBtn(e.target);
    });
    document.getElementById('btnModelBearing')?.addEventListener('click', (e) => {
      loadModelPreset('bearing');
      highlightBtn(e.target);
    });
    document.getElementById('btnModelCross')?.addEventListener('click', (e) => {
      loadModelPreset('cross');
      highlightBtn(e.target);
    });

    function highlightBtn(target) {
      document.querySelectorAll('#btnModelIris, #btnModelBearing, #btnModelCross').forEach(b => {
        b.className = "px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition";
      });
      if (target) {
        target.className = "px-3 py-1.5 rounded-md bg-brandAccent text-brandDark font-bold transition";
      }
    }

    // Wireframe & AutoRotate Toggle
    document.getElementById('btnToggleWireframe')?.addEventListener('click', (e) => {
      isWireframe = !isWireframe;
      if (e.target) e.target.innerText = `वायरफ्रेम: ${isWireframe ? 'ON' : 'OFF'}`;
      if (currentMeshGroup) {
        currentMeshGroup.traverse((child) => {
          if (child.isMesh) child.material.wireframe = isWireframe;
        });
      }
    });

    document.getElementById('btnToggleAutoRotate')?.addEventListener('click', (e) => {
      autoRotate = !autoRotate;
      if (controls) controls.autoRotate = autoRotate;
      if (e.target) e.target.innerText = `ऑटो-रोटेट: ${autoRotate ? 'ON' : 'OFF'}`;
    });

    // Material Color Pickers
    document.getElementById('colorBlack')?.addEventListener('click', () => updateViewerColor(0x111827));
    document.getElementById('colorGreen')?.addEventListener('click', () => updateViewerColor(0x10b981));
    document.getElementById('colorCyan')?.addEventListener('click', () => updateViewerColor(0x38bdf8));

    function updateViewerColor(hex) {
      currentColor = hex;
      if (currentMeshGroup) {
        currentMeshGroup.traverse((child) => {
          if (child.isMesh && child.material) child.material.color.setHex(hex);
        });
      }
    }

    // ----------------------------------------------------
    // 2. LIVE SEARCH & CATEGORY FILTER
    // ----------------------------------------------------
    const searchInput = document.getElementById('productSearchInput');
    const catTabs = document.querySelectorAll('.category-tab');
    const productCards = document.querySelectorAll('.product-card');
    const noResultsAlert = document.getElementById('noResultsAlert');
    let activeCat = 'all';

    function filterProducts() {
      const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
      let matchCount = 0;

      productCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';

        const catMatches = (activeCat === 'all' || activeCat === cat);
        const queryMatches = (q === '' || title.includes(q) || desc.includes(q));

        if (catMatches && queryMatches) {
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResultsAlert) {
        noResultsAlert.style.display = matchCount === 0 ? 'block' : 'none';
      }
    }

    catTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        catTabs.forEach(t => {
          t.className = "category-tab px-4 py-2 rounded-full text-xs font-semibold border transition-all bg-slate-900 text-slate-400 border-brandBorder hover:border-slate-600 hover:text-white";
        });
        tab.className = "category-tab px-4 py-2 rounded-full text-xs font-semibold border transition-all bg-brandAccent text-brandDark border-brandAccent font-bold";
        activeCat = tab.getAttribute('data-category') || 'all';
        filterProducts();
      });
    });

    searchInput?.addEventListener('input', filterProducts);

    // Multi-Image Thumbnail Switcher
    document.querySelectorAll('.thumb-selector').forEach(btn => {
      btn.addEventListener('click', () => {
        const parent = btn.parentElement;
        parent?.querySelectorAll('.thumb-selector').forEach(b => {
          b.classList.remove('border-brandAccent');
          b.classList.add('border-slate-800', 'opacity-60');
        });
        btn.classList.add('border-brandAccent');
        btn.classList.remove('border-slate-800', 'opacity-60');

        const targetId = btn.getAttribute('data-target');
        const src = btn.getAttribute('data-src');
        if (targetId && src) {
          const img = document.getElementById(targetId);
          if (img) img.src = src;
        }
      });
    });

    // ----------------------------------------------------
    // 3. INSTANT 3D PRINT COST CALCULATOR & DROPZONE
    // ----------------------------------------------------
    const dropZone = document.getElementById('dropZone');
    const stlInput = document.getElementById('stlFileInput');
    const fileBadge = document.getElementById('uploadedFileBadge');
    const priceText = document.getElementById('estimatedPriceText');
    let selectedFileName = "Custom_Model.stl";

    dropZone?.addEventListener('click', () => stlInput?.click());

    stlInput?.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        selectedFileName = file.name;
        if (fileBadge) {
          fileBadge.innerText = `फ़ाइल अटैच: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
          fileBadge.classList.remove('hidden');
        }
        recalcPrice();
      }
    });

    function recalcPrice() {
      const matSelect = document.getElementById('calcMaterial');
      const infillSelect = document.getElementById('calcInfill');
      const layerSelect = document.getElementById('calcLayer');

      const matMult = parseFloat(matSelect?.options[matSelect.selectedIndex]?.getAttribute('data-mult') || '1.0');
      const infillMult = parseFloat(infillSelect?.options[infillSelect.selectedIndex]?.getAttribute('data-mult') || '1.0');
      const layerMult = parseFloat(layerSelect?.options[layerSelect.selectedIndex]?.getAttribute('data-mult') || '1.0');

      const baseCost = 350;
      const total = Math.round(baseCost * matMult * infillMult * layerMult);

      if (priceText) priceText.innerText = `₹${total}`;
      return total;
    }

    ['calcMaterial', 'calcInfill', 'calcLayer', 'calcColor'].forEach(id => {
      document.getElementById(id)?.addEventListener('change', recalcPrice);
    });

    document.getElementById('btnSendCustomQuote')?.addEventListener('click', () => {
      const mat = (document.getElementById('calcMaterial'))?.value?.toUpperCase() || 'PLA+';
      const infill = (document.getElementById('calcInfill'))?.value || '20';
      const layer = (document.getElementById('calcLayer'))?.value || '0.20';
      const color = (document.getElementById('calcColor'))?.value || 'मैट ब्लैक';
      const estPrice = recalcPrice();

      const text = `नमस्ते Gardia AI Robotics! मुझे एक कस्टम 3D मॉडल प्रिंट करवाना है।%0A%0A📁 फाइल: ${selectedFileName}%0A⚙️ मटेरियल: ${mat}%0A🔩 इनफिल: ${infill}%%0A📐 लेयर: ${layer}mm%0A🎨 कलर: ${color}%0A💰 अनुमानित कोटेशन: ₹${estPrice}%0A%0Aकृपया मेरी STL फाइल चेक करके आगे की डिलीवरी प्रक्रिया बताएं।`;
      window.open(`https://wa.me/917894114448?text=${text}`, '_blank');
    });

    // ----------------------------------------------------
    // 4. INSTANT CHECKOUT & UPI MODAL
    // ----------------------------------------------------
    const checkoutModal = document.getElementById('checkoutModal');
    const btnCloseModal = document.getElementById('btnCloseModal');
    const modalTitle = document.getElementById('modalProductTitle');
    const modalPrice = document.getElementById('modalProductPrice');
    const upiQrImage = document.getElementById('upiQrImage');
    let activeCheckoutItem = { title: '', price: 0 };

    document.querySelectorAll('.btn-open-checkout').forEach(btn => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-title') || '3D Product';
        const price = parseInt(btn.getAttribute('data-price') || '0', 10);
        activeCheckoutItem = { title, price };

        if (modalTitle) modalTitle.innerText = title;
        if (modalPrice) modalPrice.innerText = `₹${price}`;

        // Generate dynamic UPI QR
        if (upiQrImage) {
          const upiString = `upi://pay?pa=7894114448@upi&pn=Gardia%20AI%20Robotics&am=${price}&cu=INR&tn=${encodeURIComponent(title)}`;
          upiQrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(upiString)}`;
        }

        checkoutModal?.classList.remove('hidden');
        checkoutModal?.classList.add('flex');
      });
    });

    btnCloseModal?.addEventListener('click', () => {
      checkoutModal?.classList.add('hidden');
      checkoutModal?.classList.remove('flex');
    });

    document.getElementById('orderForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('custName'))?.value || '';
      const phone = (document.getElementById('custPhone'))?.value || '';
      const address = (document.getElementById('custAddress'))?.value || '';

      const orderSlip = `*=== नया 3D प्रिंट ऑर्डर पुष्टि (Gardia AI Robotics) ===*%0A%0A📦 प्रोडक्ट: ${activeCheckoutItem.title}%0A💰 कुल कीमत: ₹${activeCheckoutItem.price}%0A👤 नाम: ${name}%0A📞 फोन: ${phone}%0A📍 पता: ${address}%0A%0Aमैंने UPI QR से पेमेंट शुरू कर दी है, कृपया आर्डर कन्फर्मेशन रसीद दें।`;
      
      window.open(`https://wa.me/917894114448?text=${orderSlip}`, '_blank');
      checkoutModal?.classList.add('hidden');
    });

    // Initialize 3D Engine on Window Load
    window.addEventListener('load', function () {
      init3DViewer();
    });
  </script>

</body>
</html>