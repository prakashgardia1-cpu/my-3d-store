---

<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{brand.name} | Advanced 3D Studio & Robotics Lab</title>
  <meta name="description" content="भारत का प्रमुख 3D प्रिंटिंग और प्रिसिजन इंजीनियरिंग स्टूडियो। मैकेनिकल आर्ट, कस्टम प्रोटोटाइपिंग और STL 3D प्रिंट ऑन-डिमांड।" />
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          },
          colors: {
            brandDark: '#080c14',
            brandCard: '#0f172a',
            brandBorder: '#1e293b',
            brandAccent: '#38bdf8',
            brandGreen: '#10b981',
            brandEmerald: '#059669'
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar & Aesthetics */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #080c14; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #38bdf8; }

    .glow-cyan {
      box-shadow: 0 0 25px -5px rgba(56, 189, 248, 0.25);
    }
    .glow-emerald {
      box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.3);
    }
  </style>
</head>
<body class="bg-brandDark text-slate-100 font-sans antialiased selection:bg-brandAccent selection:text-brandDark">

  <!-- Navigation Bar -->
  <header class="sticky top-0 z-50 bg-brandDark/85 backdrop-blur-md border-b border-brandBorder px-4 lg:px-8 py-3.5 transition-all">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brandAccent to-emerald-500 flex items-center justify-center font-black text-brandDark shadow-lg shadow-brandAccent/20">
          G
        </div>
        <div>
          <span class="text-lg lg:text-xl font-extrabold tracking-tight text-white block leading-tight">
            {brand.name}
          </span>
          <span class="text-[10px] font-mono text-brandAccent tracking-wider uppercase font-semibold">
            R&D Studio • {brand.domain}
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <a href="#quote-calculator" class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700 hover:border-brandAccent transition">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          कैलकुलेटर (Instant Quote)
        </a>
        <a href="#viewer-section" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-brandAccent/10 text-brandAccent border border-brandAccent/30 hover:bg-brandAccent hover:text-brandDark transition duration-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/></svg>
          3D व्यूअर
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-16">

    <!-- Hero Section -->
    <section class="text-center pt-6 pb-2 relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brandAccent/10 border border-brandAccent/20 text-brandAccent text-xs font-mono font-medium mb-4">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brandAccent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brandAccent"></span>
        </span>
        Bambu Lab & Voron Driven Precision Prototyping
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-b from-white via-slate-100 to-slate-400 max-w-4xl mx-auto leading-[1.15]">
        प्रिसिजन 3D प्रिंट्स & हाई-टॉलरेंस इंजीनियरिंग क्राफ्ट्स
      </h1>
      <p class="mt-4 text-slate-400 text-sm sm:text-base max-w-2xl mx-auto">
        हम सिर्फ प्लास्टिक प्रिंट नहीं करते; हर 3D मॉडल को सटीक टॉलरेंस (0.16mm), हैंड सैंडिंग और प्रोटेक्टिव मैट फिनिश के साथ तैयार करते हैं।
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href="#products-catalog" class="px-6 py-3 rounded-xl bg-brandGreen hover:bg-brandEmerald text-white font-bold text-sm transition shadow-lg shadow-brandGreen/25 inline-flex items-center gap-2">
          <span>🛍️ कैटलॉग एक्सप्लोर करें</span>
        </a>
        <a href="#quote-calculator" class="px-6 py-3 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-sm transition inline-flex items-center gap-2">
          <span>📐 अपनी STL फाइल प्रिंट करवाएं</span>
        </a>
      </div>
    </section>

    <!-- Interactive 3D Model Viewer (Three.js) -->
    <section id="viewer-section" class="scroll-mt-24 rounded-2xl border border-brandBorder bg-gradient-to-b from-slate-900 to-brandCard p-5 sm:p-8 glow-cyan relative overflow-hidden">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
        <div>
          <span class="text-xs font-mono font-bold text-brandAccent tracking-wider uppercase">Interactive WebGL Engine</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white mt-1">360° 3D मॉडल व्यूअर (लाइव सिमुलेशन)</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">माउस या टच से मॉडल को घुमाएं, ज़ूम करें और अलग-अलग मटेरियल व वायरफ्रेम में टेस्ट करें।</p>
        </div>

        <!-- Viewer Controls -->
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
          <div class="bg-slate-800 p-1 rounded-lg border border-slate-700 flex gap-1">
            <button id="btnModelIris" class="px-3 py-1.5 rounded-md bg-brandAccent text-brandDark font-bold transition">आइरिस</button>
            <button id="btnModelBearing" class="px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition">बेयरिंग</button>
            <button id="btnModelCross" class="px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition">क्रॉस</button>
          </div>

          <button id="btnToggleWireframe" class="px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:border-brandAccent transition">
            वायरफ्रेम: OFF
          </button>
          
          <button id="btnToggleAutoRotate" class="px-3 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 hover:text-white hover:border-brandAccent transition">
            ऑटो-रोटेट: ON
          </button>
        </div>
      </div>

      <!-- Canvas Area -->
      <div class="relative w-full h-[360px] sm:h-[460px] rounded-xl bg-black/60 border border-slate-800 overflow-hidden">
        <canvas id="threeCanvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
        
        <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-md border border-slate-700 text-[11px] font-mono text-slate-300 pointer-events-none flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span id="viewerInfoText">मैकेनिकल आइरिस (8-ब्लेड असेंबली)</span>
        </div>

        <div class="absolute top-3 right-3 flex flex-col gap-1.5">
          <button id="colorBlack" class="w-6 h-6 rounded-full bg-zinc-900 border-2 border-white/50 hover:scale-110 transition shadow" title="मैट ब्लैक"></button>
          <button id="colorGreen" class="w-6 h-6 rounded-full bg-emerald-500 border-2 border-transparent hover:scale-110 transition shadow" title="एमराल्ड ग्रीन"></button>
          <button id="colorCyan" class="w-6 h-6 rounded-full bg-cyan-400 border-2 border-transparent hover:scale-110 transition shadow" title="इंजीनियरिंग ब्लू"></button>
        </div>
      </div>
    </section>

    <!-- Live Search & Category Filter Navigation -->
    <section id="products-catalog" class="scroll-mt-24 space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">हमारा 3D प्रिंटेड क्राफ्ट्स कैटलॉग</h2>
        <p class="text-slate-400 text-xs sm:text-sm">अपनी पसंद का प्रोडक्ट चुनें, 3D एंगल्स देखें और सीधे ऑनलाइन ऑर्डर या व्हाट्सएप करें।</p>
      </div>

      <!-- Real-Time Search Bar -->
      <div class="max-w-xl mx-auto relative">
        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 text-sm">
          🔍
        </span>
        <input 
          type="text" 
          id="productSearchInput" 
          placeholder="प्रोडक्ट खोजें (जैसे: आइरिस, बेयरिंग, कीचेन, ट्रे, जीसस)..."
          class="w-full pl-11 pr-4 py-3 rounded-full bg-slate-900/90 border border-brandBorder text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brandAccent focus:ring-2 focus:ring-brandAccent/20 transition shadow-inner"
        />
      </div>

      <!-- Filter Categories -->
      <div class="flex items-center justify-center flex-wrap gap-2 pt-1">
        {categories.map((cat, idx) => (
          <button 
            class={`category-tab px-4 py-2 rounded-full text-xs font-semibold border transition-all ${idx === 0 ? 'bg-brandAccent text-brandDark border-brandAccent font-bold' : 'bg-slate-900 text-slate-400 border-brandBorder hover:border-slate-600 hover:text-white'}`}
            data-category={cat.id}
          >
            {cat.name}
          </button>
        ))}
      </div>

      <!-- Products Grid -->
