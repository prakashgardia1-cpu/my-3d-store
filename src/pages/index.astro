---
const brand = {
  name: "Gardia AI Robotics",
  labTag: "3D Engineering & Craft Studio",
  whatsappNumber: "917894114448"
};

const products = [
  {
    id: 1,
    title: "मैकेनिकल आइरिस डेस्क शोपीस (Hand-Finished)",
    price: "799",
    originalPrice: "1,299",
    discount: "38% OFF",
    image: "/product.jpeg",
    badge: "⚡ सिग्नेचर एडिशन • हैंड-क्राफ्टेड",
    description: "इंजीनियरिंग-ग्रेड eSUN PLA+ से प्रिसिजन 3D प्रिंटेड, कई चरणों की स्मूथ सैंडिंग और प्रीमियम मैट प्रोटेक्टिव कोट के साथ तैयार किया गया एक यूनिक मैकेनिकल शोपीस। आपके वर्कस्पेस या टेक डेस्क के लिए एकदम परफेक्ट।",
    specs: [
      { label: "प्रिंट टेक्नोलॉजी", val: "FDM प्रिसिजन (0.16mm लेयर)" },
      { label: "मटेरियल ग्रेड", val: "eSUN प्रीमियम टफ PLA+" },
      { label: "फिनिशिंग प्रोसेस", val: "हैंड-सैंडेड + मैट प्रोटेक्टिव शील्ड" },
      { label: "डायमेंशन", val: "व्यास: 12 सेमी | ऊंचाई: 6 सेमी" },
      { label: "कुल वजन", val: "लगभग 110 ग्राम" },
      { label: "शिपिंग", val: "पूरे भारत में सुरक्षित फ्री डिलीवरी" }
    ]
  }
];

const waCustomMsg = encodeURIComponent("नमस्ते Gardia AI Robotics! मुझे एक कस्टम 3D मॉडल / STL फाइल प्रिंट करवानी है। कृपया कोटेशन की जानकारी दें।");
---

<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{brand.name} | Precision 3D Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111827;
      --card-hover: #162032;
      --border: #1f293d;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --green: #10b981;
      --green-dark: #059669;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background-color: var(--bg); color: var(--text-main); line-height: 1.6; }

    /* Navigation */
    header {
      background: rgba(17, 24, 39, 0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      position: sticky; top: 0; z-index: 100; padding: 1rem 1.5rem;
    }
    .nav-inner {
      max-width: 1080px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;
    }
    .brand-wrap { display: flex; align-items: center; gap: 0.6rem; }
    .brand-title { font-size: 1.25rem; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
    .brand-badge {
      font-size: 0.7rem; background: rgba(56, 189, 248, 0.12); color: var(--accent);
      padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid rgba(56, 189, 248, 0.3); font-weight: 600;
    }

    /* Container */
    .container { max-width: 1080px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

    /* Hero */
    .hero {
      text-align: center; padding: 3rem 1rem 3.5rem;
      border-bottom: 1px solid var(--border); margin-bottom: 3.5rem;
    }
    .hero-tag {
      display: inline-block; font-size: 0.8rem; font-weight: 600; color: var(--accent);
      text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 0.8rem;
    }
    .hero-h1 {
      font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 800; line-height: 1.2;
      background: linear-gradient(180deg, #ffffff 0%, #94a3b8 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 1rem;
    }
    .hero-p {
      max-width: 650px; margin: 0 auto 1.75rem; color: var(--text-muted); font-size: 1.05rem;
    }

    /* Product Card */
    .section-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
    .product-box {
      display: grid; grid-template-columns: 1fr; gap: 2.5rem;
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 20px; overflow: hidden; padding: 1.75rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    @media (min-width: 820px) {
      .product-box { grid-template-columns: 1.05fr 1.15fr; padding: 2.5rem; gap: 3rem; }
    }

    .img-box {
      position: relative; border-radius: 14px; overflow: hidden;
      background: #000; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;
    }
    .img-box img {
      width: 100%; height: auto; max-height: 440px; object-fit: cover; display: block;
      transition: transform 0.4s ease;
    }
    .img-box:hover img { transform: scale(1.03); }

    .card-badge {
      position: absolute; top: 1rem; left: 1rem;
      background: rgba(15, 23, 42, 0.88); backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.15); color: #fbbf24;
      font-size: 0.75rem; font-weight: 700; padding: 0.35rem 0.8rem; border-radius: 999px;
    }

    .product-details { display: flex; flex-direction: column; justify-content: space-between; }
    .item-title { font-size: 1.65rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.8rem; }
    
    .price-row { display: flex; align-items: baseline; gap: 0.85rem; margin-bottom: 1.25rem; }
    .now-price { font-size: 2.1rem; font-weight: 800; color: var(--accent); }
    .old-price { font-size: 1.2rem; color: var(--text-muted); text-decoration: line-through; }
    .save-tag {
      background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.8rem;
      font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid rgba(52, 211, 153, 0.3);
    }

    .item-desc { color: var(--text-muted); font-size: 0.96rem; margin-bottom: 1.6rem; }

    /* Specs Grid */
    .specs {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;
      margin-bottom: 1.75rem; background: #0c121e; padding: 1.1rem;
      border-radius: 10px; border: 1px solid var(--border);
    }
    .spec-h { color: #64748b; font-size: 0.72rem; text-transform: uppercase; font-weight: 700; margin-bottom: 0.2rem; }
    .spec-v { color: #e2e8f0; font-size: 0.88rem; font-weight: 600; }

    /* Buttons */
    .btn-action { display: flex; flex-direction: column; gap: 0.85rem; }
    .btn-primary {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      padding: 1rem 1.4rem; border-radius: 10px; font-size: 1rem; font-weight: 700;
      text-decoration: none; background: var(--green); color: #fff;
      transition: all 0.2s ease; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
    }
    .btn-primary:hover { background: var(--green-dark); transform: translateY(-1px); }

    .btn-secondary {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      padding: 0.85rem 1.4rem; border-radius: 10px; font-size: 0.95rem; font-weight: 600;
      text-decoration: none; background: #1e293b; color: #f1f5f9; border: 1px solid #334155;
      transition: background 0.2s ease;
    }
    .btn-secondary:hover { background: #334155; }

    /* Craftsmanship Section */
    .process-section { margin-top: 4.5rem; }
    .process-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem; margin-top: 1.5rem;
    }
    .process-card {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.5rem; position: relative;
    }
    .process-num {
      font-size: 1.7rem; font-weight: 800; color: var(--accent); opacity: 0.8; margin-bottom: 0.5rem;
    }
    .process-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .process-desc { font-size: 0.88rem; color: var(--text-muted); }

    /* Trust Grid */
    .trust-wrap {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem; margin-top: 3.5rem; text-align: center;
    }
    .trust-box {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.25rem 1rem;
    }
    .trust-ico { font-size: 1.7rem; margin-bottom: 0.4rem; }
    .trust-title { font-size: 0.92rem; font-weight: 700; color: #f1f5f9; margin-bottom: 0.2rem; }
    .trust-sub { font-size: 0.78rem; color: var(--text-muted); }

    /* Footer */
    footer {
      border-top: 1px solid var(--border); background: #070a10;
      text-align: center; padding: 2.5rem 1rem; color: #64748b; font-size: 0.85rem;
    }
    .footer-msme { color: var(--accent); font-weight: 600; margin-top: 0.4rem; font-size: 0.8rem; }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="nav-inner">
      <div class="brand-wrap">
        <span class="brand-title">{brand.name}</span>
        <span class="brand-badge">R&D 3D Lab</span>
      </div>
      <a href={`https://wa.me/${brand.whatsappNumber}?text=${waCustomMsg}`} class="btn-secondary" style="padding: 0.45rem 0.9rem; font-size: 0.82rem; border-radius: 8px;">
        कस्टम 3D प्रिंटिंग
      </a>
    </div>
  </header>

  <div class="container">
    <!-- Hero Header -->
    <section class="hero">
      <span class="hero-tag">Precision Engineering • Artisan Finish</span>
      <h1 class="hero-h1">भरोसेमंद 3D प्रिंटिंग & यूनिक क्राफ्ट्स</h1>
      <p class="hero-p">
        हम सिर्फ प्लास्टिक प्रिंट नहीं करते; हर मॉडल को सही टॉलरेंस, स्मूथ सैंडिंग और प्रोटेक्टिव मैट फिनिश के साथ तैयार करते हैं।
      </p>
    </section>

    <!-- Product Showcase -->
    <h2 class="section-title">✨ फीचर्ड प्रॉडक्ट</h2>
    <div class="product-box">
      <div class="img-box">
        <span class="card-badge">{products[0].badge}</span>
        <img src={products[0].image} alt={products[0].title} />
      </div>

      <div class="product-details">
        <div>
          <h3 class="item-title">{products[0].title}</h3>
          <div class="price-row">
            <span class="now-price">₹{products[0].price}</span>
            <span class="old-price">{products[0].originalPrice}</span>
            <span class="save-tag">{products[0].discount}</span>
          </div>
          <p class="item-desc">{products[0].description}</p>

          <div class="specs">
            {products[0].specs.map(s => (
              <div>
                <div class="spec-h">{s.label}</div>
                <div class="spec-v">{s.val}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="btn-action">
          <a href={`https://wa.me/${brand.whatsappNumber}?text=${encodeURIComponent(`नमस्ते ${brand.name}! मुझे "${products[0].title}" (₹${products[0].price}) ऑर्डर करना है। कृपया पेमेंट और डिलीवरी डिटेल साझा करें।`)}`} class="btn-primary">
            💬 व्हाट्सएप पर तुरंत ऑर्डर करें
          </a>
          <a href={`https://wa.me/${brand.whatsappNumber}?text=${waCustomMsg}`} class="btn-secondary">
            📁 अपनी STL / CAD फाइल भेजकर कोटेशन लें
          </a>
        </div>
      </div>
    </div>

    <!-- Craftsmanship Process -->
    <section class="process-section">
      <h2 class="section-title">🛠️ हमारा मैन्युफैक्चरिंग प्रोसेस</h2>
      <div class="process-grid">
        <div class="process-card">
          <div class="process-num">01</div>
          <h4 class="process-title">प्रिसिजन FDM प्रिंटिंग</h4>
          <p class="process-desc">हाई-ग्रेड eSUN PLA+ मटेरियल और 0.16mm लेयर एक्यूरेसी के साथ मजबूत मैकेनिकल बॉन्डिंग।</p>
        </div>
        <div class="process-card">
          <div class="process-num">02</div>
          <h4 class="process-title">हैंड सैंडिंग & स्मूथिंग</h4>
          <p class="process-desc">मल्टी-स्टेज सैंडिंग द्वारा लेयर लाइनों को खत्म करके अल्ट्रा-स्मूथ और साफ टेक्सचर दिया जाता है।</p>
        </div>
        <div class="process-card">
          <div class="process-num">03</div>
          <h4 class="process-title">प्रोटेक्टिव मैट शील्ड</h4>
          <p class="process-desc">प्रीमियम मैट क्लियर कोट जो मॉडल को स्क्रैच, धूल और धूप से सुरक्षित रखता है।</p>
        </div>
      </div>
    </section>

    <!-- Trust Badges -->
    <div class="trust-wrap">
      <div class="trust-box">
        <div class="trust-ico">📦</div>
        <div class="trust-title">ऑल इंडिया फ्री शिपिंग</div>
        <div class="trust-sub">मजबूत बॉक्स और बबल पैकेजिंग</div>
      </div>
      <div class="trust-box">
        <div class="trust-ico">🛡️</div>
        <div class="trust-title">डैमेज रिप्लेसमेंट गारंटी</div>
        <div class="trust-sub">ट्रांजिट में खराबी पर तुरंत नया पीस</div>
      </div>
      <div class="trust-box">
        <div class="trust-ico">⚡</div>
        <div class="trust-title">कस्टम प्रोटोटाइपिंग</div>
        <div class="trust-sub">आपकी अपनी STL फाइल पर प्रिंट सपोर्ट</div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <p>© 2026 {brand.name}. सर्वाधिकार सुरक्षित।</p>
    <p class="footer-msme">गवर्नमेंट रजिस्टर्ड MSME एंटरप्राइज • रोबोटिक्स & 3D सॉल्यूशंस</p>
  </footer>

</body>
</html>