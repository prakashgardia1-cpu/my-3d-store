          </div>

          <!-- Thumbnails for Multi-Photos -->
          {item.images && item.images.length > 1 && (
            <div class="flex gap-2 px-4 py-2 bg-slate-900/60 border-b border-brandBorder">
              {item.images.map((imgUrl, imgIndex) => (
                <button 
                  class={`thumb-selector w-10 h-10 rounded-lg overflow-hidden border-2 transition ${imgIndex === 0 ? 'border-brandAccent' : 'border-slate-800 opacity-60 hover:opacity-100'}`}
                  data-target={`prod-img-${item.id}`}
                  data-src={imgUrl}
                >
                  <img src={imgUrl} alt="Thumbnail" class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}

          <!-- Product Details -->
          <div class="p-5 flex flex-col flex-grow justify-between space-y-4">
            <div class="space-y-2">
              <h3 class="text-base font-bold text-white leading-snug">{item.title}</h3>
              
              <div class="flex items-baseline gap-2.5">
                <span class="text-2xl font-black text-brandAccent font-mono">₹{item.price}</span>
                <span class="text-xs text-slate-500 line-through font-mono">₹{item.originalPrice}</span>
                <span class="text-[11px] font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">{item.discount}</span>
              </div>

              <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">{item.description}</p>

              <div class="grid grid-cols-2 gap-2 p-2.5 rounded-xl bg-slate-950/60 border border-brandBorder text-[11px]">
                {item.specs.map(s => (
                  <div>
                    <span class="block text-slate-500 font-semibold text-[10px] uppercase">{s.label}</span>
                    <span class="text-slate-300 font-medium">{s.val}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- CTA Actions -->
            <div class="grid grid-cols-2 gap-2 pt-2">
              <button 
                class="btn-open-checkout w-full py-2.5 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-brandDark font-bold text-xs flex items-center justify-center gap-1.5 transition shadow"
                data-id={item.id}
                data-title={item.title}
                data-price={item.price}
              >
                ⚡ Buy Now
              </button>
              <a 
                href={`https://wa.me/${brand.whatsappNumber}?text=${waOrderText}`} 
                target="_blank" 
                rel="noopener"
                class="w-full py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-xs flex items-center justify-center gap-1.5 transition text-center"
              >
                💬 WhatsApp
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

