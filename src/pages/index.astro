---

<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{brand.name} | 3D Studio & Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111827;
      --border: #1f293d;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --green: #10b981;
      --green-dark: #059669;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background-color: var(--bg); color: var(--text-main); line-height: 1.6; padding-bottom: 4rem; }

    header {
      background: rgba(17, 24, 39, 0.9); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; padding: 1rem 1.5rem;
    }
    .nav-inner {
      max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;
    }
    .brand-wrap { display: flex; align-items: center; gap: 0.6rem; }
    .brand-title { font-size: 1.25rem; font-weight: 800; color: #fff; }
    .brand-badge {
      font-size: 0.7rem; background: rgba(56, 189, 248, 0.12); color: var(--accent);
      padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid rgba(56, 189, 248, 0.3); font-weight: 600;
    }

    .container { max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.25rem 0; }

    .hero {
      text-align: center; padding: 2rem 1rem 2.5rem;
      border-bottom: 1px solid var(--border); margin-bottom: 2.5rem;
    }
    .hero-h1 {
      font-size: clamp(2rem, 5vw, 2.7rem); font-weight: 800; line-height: 1.2;
      background: linear-gradient(180deg, #ffffff 0%, #94a3b8 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 0.8rem;
    }
    .hero-p { max-width: 650px; margin: 0 auto; color: var(--text-muted); font-size: 1rem; }

    /* Filter Tabs */
    .filter-wrapper {
      display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2.5rem;
    }
    .filter-btn {
      background: #111827; border: 1px solid var(--border); color: var(--text-muted);
      padding: 0.55rem 1.2rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600;
      cursor: pointer; transition: all 0.2s ease;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--accent); color: #090d16; border-color: var(--accent); font-weight: 700;
    }

    /* Products Grid */
    .products-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2rem;
    }

    .product-card {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 16px; overflow: hidden; display: flex; flex-direction: column;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .product-card:hover { transform: translateY(-4px); border-color: #334155; }

    .media-box {
      position: relative; width: 100%; height: 280px; background: #000; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .media-box img, .media-box video {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .product-card:hover .media-box img { transform: scale(1.04); transition: transform 0.4s ease; }

    .card-badge {
      position: absolute; top: 0.85rem; left: 0.85rem; z-index: 10;
      background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.15); color: #fbbf24;
      font-size: 0.72rem; font-weight: 700; padding: 0.3rem 0.7rem; border-radius: 999px;
    }

    .card-content { padding: 1.4rem; display: flex; flex-direction: column; flex-grow: 1; }
    .item-title { font-size: 1.25rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.6rem; color: #fff; }

    .price-row { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.85rem; }
    .now-price { font-size: 1.7rem; font-weight: 800; color: var(--accent); }
    .old-price { font-size: 1.05rem; color: var(--text-muted); text-decoration: line-through; }
    .save-tag {
      background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.75rem;
      font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px;
    }

    .item-desc { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 1.2rem; flex-grow: 1; }

    .specs {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
      margin-bottom: 1.4rem; background: #0c121e; padding: 0.85rem;
      border-radius: 8px; border: 1px solid var(--border);
    }
    .spec-h { color: #64748b; font-size: 0.68rem; text-transform: uppercase; font-weight: 700; }
    .spec-v { color: #e2e8f0; font-size: 0.82rem; font-weight: 600; }

    .btn-buy {
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.85rem 1rem; border-radius: 10px; font-size: 0.95rem; font-weight: 700;
      text-decoration: none; background: var(--green); color: #fff;
      transition: background 0.2s ease;
    }
    .btn-buy:hover { background: var(--green-dark); }

    /* Trust Section */
    .trust-wrap {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem; margin-top: 4rem; text-align: center;
    }
    .trust-box {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 14px; padding: 1.25rem 1rem;
    }
    .trust-ico { font-size: 1.6rem; margin-bottom: 0.3rem; }
    .trust-title { font-size: 0.92rem; font-weight: 700; color: #f1f5f9; }
    .trust-sub { font-size: 0.78rem; color: var(--text-muted); }

    footer {
      border-top: 1px solid var(--border); background: #070a10;
      text-align: center; padding: 2.5rem 1rem; margin-top: 4rem; color: #64748b; font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <header>
    <div class="nav-inner">
      <div class="brand-wrap">
        <span class="brand-title">{brand.name}</span>
        <span class="brand-badge">3D Lab</span>
      </div>
      <a href={`https://wa.me/${brand.whatsappNumber}?text=${waCustomMsg}`} style="padding: 0.45rem 0.9rem; font-size: 0.82rem; border-radius: 8px; text-decoration: none; background: #1e293b; color: #fff; border: 1px solid #334155; font-weight: 600;">
        कस्टम 3D प्रिंटिंग
      </a>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1 class="hero-h1">प्रिसिजन 3D प्रिंट्स & क्राफ्ट्स</h1>
      <p class="hero-p">
        सटीक टॉलरेंस, हाई-स्ट्रेंथ PLA+ और स्मूथ फिनिशिंग के साथ तैयार डेस्क शोपीस, टूल्स और प्रोटोटाइप्स।
      </p>
    </section>

    <!-- Filter Buttons -->
    <div class="filter-wrapper">
      {categories.map((cat, idx) => (
        <button class={`filter-btn ${idx === 0 ? 'active' : ''}`} data-filter={cat.id}>
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Product Grid -->
    <div class="products-grid">
      {products.map((item) => {
        const itemOrderMsg = encodeURIComponent(`नमस्ते ${brand.name}! मुझे "${item.title}" (₹${item.price}) ऑर्डर करना है। कृपया आगे की जानकारी दें।`);
        return (
          <article class="product-card" data-category={item.category}>
            <div class="media-box">
              <span class="card-badge">{item.badge}</span>
              {item.mediaType === 'video' ? (
                <video autoplay loop muted playsinline>
                  <source src={item.mediaSrc} type="video/mp4" />
                </video>
              ) : (
                <img src={item.mediaSrc} alt={item.title} />
              )}
            </div>

            <div class="card-content">
              <h2 class="item-title">{item.title}</h2>
              <div class="price-row">
                <span class="now-price">₹{item.price}</span>
                <span class="old-price">₹{item.originalPrice}</span>
                <span class="save-tag">{item.discount}</span>
              </div>
              <p class="item-desc">{item.description}</p>

              <div class="specs">
                {item.specs.map(s => (
                  <div>
                    <div class="spec-h">{s.label}</div>
                    <div class="spec-v">{s.val}</div>
                  </div>
                ))}
              </div>

              <a href={`https://wa.me/${brand.whatsappNumber}?text=${itemOrderMsg}`} class="btn-buy">
                💬 व्हाट्सएप पर ऑर्डर करें
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Trust Badges -->
    <div class="trust-wrap">
      <div class="trust-box">
        <div class="trust-ico">📦</div>
        <div class="trust-title">ऑल इंडिया डिलीवरी</div>
        <div class="trust-sub">सुरक्षित बबल रैप और बॉक्स पैकेजिंग</div>
      </div>
      <div class="trust-box">
        <div class="trust-ico">🛡️</div>
        <div class="trust-title">डैमेज प्रोटेक्शन</div>
        <div class="trust-sub">रास्ते में नुकसान पर तुरंत फ्री रिप्लेसमेंट</div>
      </div>
      <div class="trust-box">
        <div class="trust-ico">⚡</div>
        <div class="trust-title">कस्टम CAD / STL</div>
        <div class="trust-sub">आपकी अपनी फाइल पर ऑन-डिमांड 3D प्रिंटिंग</div>
      </div>
    </div>
  </main>

  <footer>
    <p>© 2026 {brand.name}. सर्वाधिकार सुरक्षित।</p>
    <p style="color: var(--accent); margin-top: 0.3rem; font-size: 0.8rem;">गवर्नमेंट रजिस्टर्ड MSME एंटरप्राइज</p>
  </footer>

  <!-- Filter Script -->
  <script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.product-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || filter === category) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>

</body>
</html>